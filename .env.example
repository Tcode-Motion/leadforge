# ====================================================================
# LeadForge Environment Configuration Template (.env.example)
# Copy this file to .env and configure for your local environment.
# Note: LeadForge works 100% out of the box in Local Standalone Mode
# without requiring any paid API keys or Docker installations.
# ====================================================================

# Dashboard Server Settings
LEADFORGE_HOST=127.0.0.1
LEADFORGE_PORT=8790
LEADFORGE_MANAGED_LAUNCH=0

# AI Provider API Keys (Optional - Free tier or local Ollama)
# Leave blank to use LeadForge's built-in consultative smart templates.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Local AI (Ollama) Endpoints
LEADFORGE_OLLAMA_URL=http://127.0.0.1:11434/v1/chat/completions
LEADFORGE_OLLAMA_MODEL=qwen2.5:3b

# Standalone Microservice Ports (Zero-Docker Native Local Mode)
LISTMONK_PORT=9000
CHATWOOT_PORT=3001
CALDIY_PORT=3002
TWENTY_PORT=3003
DOCUMENSO_PORT=3004

# WhatsApp Web Closer Configuration
# Session directory for persistent browser profile (1-time QR scan)
WHATSAPP_SESSION_PATH=dashboard/data/whatsapp_session
WHATSAPP_HEADLESS=false
