# ====================================================================
# LeadForge .gitignore
# ====================================================================

# Environment & Secrets (Never commit credentials or tokens)
.env
*.env
*/.env
*.env.*
!.env.example
!*/.env.example

# Dashboard Dynamic State & Storage
dashboard/data/*
!dashboard/data/KEEP_THIS_FOLDER.txt
!dashboard/data/*.example
dashboard/data/logs/
dashboard/data/runs/
dashboard/data/notes/
dashboard/data/runtime/
dashboard/data/pitches/
dashboard/data/reports/
dashboard/data/whatsapp_session/
dashboard/data/whatsapp_agent_state.json
dashboard/data/leads.json
dashboard/data/ai-settings.json
dashboard/data/server-info.json
dashboard/data/app-ports.json
dashboard/data/apps_data.json
dashboard/data/agency-profile.json
dashboard/data/agency_profile.json
dashboard/data/chatwoot-sync.json
dashboard/data/latest.csv
dashboard/data/latest-meta.json

# Docker & Container Generated Runtime Files
docker-compose.leadforge.yml

# Scraper & Crawler Output Cache
results*.csv
*/results.csv
2-understand-crawl4ai/output/

# Python Build & Bytecode
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/

# Playwright & Testing Outputs
.pytest_cache/
test-results/
playwright-report/
blob-report/
tests/__pycache__/
tests/.pytest_cache/

# OS & Editor Files
*.log
*.tmp
*.bak
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
